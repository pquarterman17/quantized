{
  "name": "quantized-frontend",
  "private": true,
  "version": "0.26.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "api:types": "openapi-typescript api/openapi.json -o src/lib/api/schema.d.ts --default-non-nullable false",
    "lint": "eslint --max-warnings=0 src",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --config=e2e/playwright.config.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "d3-contour": "^4.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uplot": "^1.6.31",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-contour": "^3.0.6",
    "@types/jsdom": "30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "canvas": "^3.2.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
