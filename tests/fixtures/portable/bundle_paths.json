{
  "//": [
    "P1.7 PR 5 audit item 2: `is_bundle_relative` (src/quantized/portable/layout.py)",
    "and `isBundleRelativePath` (frontend/src/lib/bundlePath.ts) are two",
    "independent, hand-maintained ports of the SAME containment rule -- this",
    "fixture is the single source of truth both a pytest",
    "(tests/test_portable_bundle_paths_fixture.py) and a vitest",
    "(frontend/src/lib/bundlePath.fixture.test.ts) consume, so the two",
    "implementations can never quietly drift apart again. Each entry is",
    "`{path, accept}`: `accept: true` means the path MUST validate as",
    "bundle-relative on both sides; `accept: false` means it MUST be",
    "rejected on both sides. `path` is the raw string as it appears once",
    "JSON-decoded (a `\\u0000` escape below decodes to a literal NUL byte on",
    "both the Python and the JS side)."
  ],
  "cases": [
    { "path": "sources/a.csv", "accept": true, "note": "plain sources/-rooted path" },
    { "path": "sources/sub/a.csv", "accept": true, "note": "nested one level" },
    { "path": "sources/sub/deeper/a.csv", "accept": true, "note": "nested two levels" },
    { "path": "sources/\u65e5\u672c\u8a9e-\u30b5\u30f3\u30d7\u30eb.csv", "accept": true, "note": "Unicode filename" },
    { "path": "../x", "accept": false, "note": "parent-traversal, not even sources-rooted" },
    { "path": "sources/../x", "accept": false, "note": "parent-traversal segment inside sources/" },
    { "path": "sources/./x", "accept": false, "note": "current-directory segment" },
    { "path": "/abs", "accept": false, "note": "absolute POSIX path" },
    { "path": "C:/x", "accept": false, "note": "drive-letter path, forward slash" },
    { "path": "c:/x", "accept": false, "note": "drive-letter path, lowercase drive letter" },
    { "path": "C:\\x", "accept": false, "note": "drive-letter path, backslash" },
    { "path": "\\\\srv\\share", "accept": false, "note": "UNC path, backslash form" },
    { "path": "//srv/share", "accept": false, "note": "UNC-ish path, forward-slash form" },
    { "path": "sources\\a.csv", "accept": false, "note": "backslash separator, never reinterpreted" },
    { "path": "sources//a", "accept": false, "note": "doubled separator == empty segment" },
    { "path": "other/a.csv", "accept": false, "note": "not rooted at sources/" },
    { "path": "sources/a\u0000.csv", "accept": false, "note": "NUL byte inside a segment" },
    { "path": "", "accept": false, "note": "empty string" },
    { "path": "sources/", "accept": false, "note": "trailing separator, empty final segment" },
    { "path": "sources/..", "accept": false, "note": "bare .. as the final segment" },
    { "path": "sources/D:evil", "accept": false, "note": "colon inside a segment (drive-letter-ish)" },
    { "path": "sources/a<b", "accept": false, "note": "illegal character inside a segment" },
    { "path": "sources/CON.csv", "accept": false, "note": "Windows-reserved device name" },
    { "path": "sources/NUL.tar.gz", "accept": false, "note": "reserved name survives a compound extension" },
    { "path": "sources/x.", "accept": false, "note": "trailing dot" },
    { "path": "sources/x ", "accept": false, "note": "trailing space" }
  ]
}
